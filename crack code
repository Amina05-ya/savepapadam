import cv2
import numpy as np

# =====================================================
# PAPPADAM GUARD - CRACK / DAMAGE DETECTION
# =====================================================

# 1 = DroidCam / phone camera
# If your phone camera is on another number, try 0, 2 or 3
camera = cv2.VideoCapture(1)

if not camera.isOpened():
    print("ERROR: Camera not found!")
    print("Try changing VideoCapture(1) to VideoCapture(0) or (2)")
    exit()

print("PappadamGuard started!")
print("Show the pappadam to the phone camera.")
print("Press Q to quit.")


while True:

    # -------------------------------------------------
    # GET CAMERA FRAME
    # -------------------------------------------------
    ret, frame = camera.read()

    if not ret:
        print("Cannot read camera!")
        break

    # Resize for easier processing
    frame = cv2.resize(frame, (825, 480))

    # -------------------------------------------------
    # FIND LIGHT-COLOURED PAPPADAM
    # -------------------------------------------------
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Pappadam is relatively bright and low in saturation
    lower = np.array([0, 0, 120])
    upper = np.array([179, 110, 255])

    pappadam_mask = cv2.inRange(hsv, lower, upper)

    # Remove small noise
    kernel = np.ones((7, 7), np.uint8)

    pappadam_mask = cv2.morphologyEx(
        pappadam_mask,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2
    )

    pappadam_mask = cv2.morphologyEx(
        pappadam_mask,
        cv2.MORPH_OPEN,
        kernel,
        iterations=1
    )

    # -------------------------------------------------
    # FIND THE BIGGEST LIGHT OBJECT
    # -------------------------------------------------
    contours, _ = cv2.findContours(
        pappadam_mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    display = frame.copy()

    if len(contours) == 0:

        cv2.putText(
            display,
            "PAPPADAM NOT DETECTED",
            (30, 50),
            cv2.FONT_HERSHEY_SIMPLEX,
            1,
            (0, 0, 255),
            2
        )

        cv2.imshow("PappadamGuard", display)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

        continue

    # Largest contour = assumed pappadam
    pappadam_contour = max(contours, key=cv2.contourArea)

    pappadam_area = cv2.contourArea(pappadam_contour)

    # Ignore very small objects
    if pappadam_area < 5000:

        cv2.putText(
            display,
            "SHOW PAPPADAM",
            (30, 50),
            cv2.FONT_HERSHEY_SIMPLEX,
            1,
            (0, 0, 255),
            2
        )

        cv2.imshow("PappadamGuard", display)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

        continue

    # -------------------------------------------------
    # CREATE PAPPADAM MASK
    # -------------------------------------------------
    mask = np.zeros(frame.shape[:2], dtype=np.uint8)

    cv2.drawContours(
        mask,
        [pappadam_contour],
        -1,
        255,
        -1
    )

    # -------------------------------------------------
    # REMOVE OUTER EDGE
    # -------------------------------------------------
    # This prevents the boundary of the pappadam
    # from being counted as a crack.

    inner_mask = cv2.erode(
        mask,
        np.ones((15, 15), np.uint8),
        iterations=1
    )

    # -------------------------------------------------
    # CONVERT TO GRAYSCALE
    # -------------------------------------------------
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    gray = cv2.GaussianBlur(
        gray,
        (5, 5),
        0
    )

    # -------------------------------------------------
    # FIND DARK CRACK / HOLE REGIONS
    # -------------------------------------------------
    # Blackhat highlights dark regions surrounded by
    # brighter regions.

    blackhat_kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (15, 15)
    )

    blackhat = cv2.morphologyEx(
        gray,
        cv2.MORPH_BLACKHAT,
        blackhat_kernel
    )

    # Threshold
    crack_mask = cv2.threshold(
        blackhat,
        20,
        255,
        cv2.THRESH_BINARY
    )[1]

    # Only consider areas INSIDE the pappadam
    crack_mask = cv2.bitwise_and(
        crack_mask,
        inner_mask
    )

    # -------------------------------------------------
    # REMOVE SMALL NOISE
    # -------------------------------------------------
    small_kernel = np.ones((3, 3), np.uint8)

    crack_mask = cv2.morphologyEx(
        crack_mask,
        cv2.MORPH_OPEN,
        small_kernel
    )

    # -------------------------------------------------
    # REMOVE VERY SMALL OBJECTS
    # -------------------------------------------------
    num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(
        crack_mask,
        8
    )

    clean_cracks = np.zeros_like(crack_mask)

    for i in range(1, num_labels):

        area = stats[i, cv2.CC_STAT_AREA]

        # Ignore tiny noise
        if area >= 5:
            clean_cracks[labels == i] = 255

    # -------------------------------------------------
    # CALCULATE DAMAGE PERCENTAGE
    # -------------------------------------------------
    pappadam_pixels = cv2.countNonZero(inner_mask)

    crack_pixels = cv2.countNonZero(clean_cracks)

    if pappadam_pixels > 0:

        damage_percentage = (
            crack_pixels / pappadam_pixels
        ) * 100

    else:

        damage_percentage = 0

    # Keep value between 0 and 100
    damage_percentage = max(
        0,
        min(100, damage_percentage)
    )

    # -------------------------------------------------
    # DRAW PAPPADAM OUTLINE
    # -------------------------------------------------
    cv2.drawContours(
        display,
        [pappadam_contour],
        -1,
        (0, 255, 0),
        2
    )

    # -------------------------------------------------
    # HIGHLIGHT DETECTED CRACKS IN RED
    # -------------------------------------------------
    red_overlay = np.zeros_like(display)

    red_overlay[:, :, 2] = clean_cracks

    display = cv2.addWeighted(
        display,
        1,
        red_overlay,
        0.8,
        0
    )

    # -------------------------------------------------
    # STATUS MESSAGE
    # -------------------------------------------------
    if damage_percentage < 5:

        status = "PAPPADAM CHILL AANU!"

    elif damage_percentage < 15:

        status = "CHERIYA SCRATCH ALLE!"

    elif damage_percentage < 30:

        status = "SCENE UND!"

    elif damage_percentage < 50:

        status = "PAPPADAM ICU-IL!"

    else:

        status = "ITHU PAPPADAM ALLA!"

    # -------------------------------------------------
    # DISPLAY DAMAGE %
    # -------------------------------------------------
    cv2.putText(
        display,
        f"DAMAGE: {damage_percentage:.1f}%",
        (25, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0, 255, 255),
        2
    )

    cv2.putText(
        display,
        status,
        (25, 75),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.75,
        (0, 255, 0),
        2
    )

    # -------------------------------------------------
    # SHOW RESULT
    # -------------------------------------------------
    cv2.imshow(
        "PappadamGuard",
        display
    )

    # Show detected crack areas separately
    cv2.imshow(
        "Detected Cracks",
        clean_cracks
    )

    # Press Q to exit
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break


# -----------------------------------------------------
# CLOSE EVERYTHING
# -----------------------------------------------------

camera.release()
cv2.destroyAllWindows()

print("PappadamGuard stopped.")
